# Notion
NOTION_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Todoist
TODOIST_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Home Assistant
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=xxxxxxxxxxxxxxxxxxxx
