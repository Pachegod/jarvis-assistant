# Copy this file to .env and fill in your values

# Claude API
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Google Services
GOOGLE_API_KEY=your-google-api-key
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Database
